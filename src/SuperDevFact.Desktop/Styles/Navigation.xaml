<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Item de navigation de la sidebar. Basé sur un RadioButton (un seul écran actif
        à la fois) mais habillé pour ne plus ressembler à un contrôle de formulaire :
        pastille d'accent à gauche quand actif, fond qui s'éclaircit légèrement au survol.
    -->
    <Style x:Key="NavigationItemStyle" TargetType="RadioButton">
        <Setter Property="GroupName" Value="MainNavigation" />
        <Setter Property="Foreground" Value="{StaticResource TextInverseMutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AccentBar" Grid.Column="0" Width="3" CornerRadius="2"
                                    Background="{StaticResource CyanBrush}" Opacity="0" Margin="-14,-2,0,-2" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource NavyMidBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource NavyMidBrush}" />
                            <Setter TargetName="AccentBar" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
