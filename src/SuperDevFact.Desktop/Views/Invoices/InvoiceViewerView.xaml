<UserControl x:Class="SuperDevFact.Desktop.Views.Invoices.InvoiceViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:SuperDevFact.Desktop.Converters"
             mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1400">

    <UserControl.Resources>
        <conv:StatusLabelConverter x:Key="StatusLabelConverter" />
        <conv:StatusBrushConverter x:Key="StatusBrushConverter" />
        <conv:StatusForegroundConverter x:Key="StatusForegroundConverter" />
        <conv:WorkflowStepBrushConverter x:Key="WorkflowStepBrushConverter" />
        <conv:WorkflowStepTextBrushConverter x:Key="WorkflowStepTextBrushConverter" />
        <conv:PaymentMethodLabelConverter x:Key="PaymentMethodLabelConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="28,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Facture" Style="{StaticResource SecondaryText}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding Number}" Style="{StaticResource DisplayText}" VerticalAlignment="Center" />
                        <Border Style="{StaticResource StatusBadgeStyle}" Margin="12,0,0,0" VerticalAlignment="Center"
                                Background="{Binding DisplayStatus, Converter={StaticResource StatusBrushConverter}}">
                            <TextBlock Style="{StaticResource StatusBadgeTextStyle}"
                                       Text="{Binding DisplayStatus, Converter={StaticResource StatusLabelConverter}}"
                                       Foreground="{Binding DisplayStatus, Converter={StaticResource StatusForegroundConverter}}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Frise (mêmes chevrons que le devis, avec l'étape "Payé" en plus) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Resources>
                        <Style TargetType="Polygon" x:Key="ChevronStyle">
                            <Setter Property="Width" Value="130" />
                            <Setter Property="Height" Value="46" />
                            <Setter Property="Stretch" Value="Fill" />
                            <Setter Property="Points" Value="0,0 88,0 100,50 88,100 0,100 14,50" />
                        </Style>
                        <Style TargetType="TextBlock" x:Key="ChevronLabelStyle" BasedOn="{StaticResource BodyText}">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="FontSize" Value="13.5" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </StackPanel.Resources>
                    <Grid>
                        <Polygon Style="{StaticResource ChevronStyle}" Fill="{StaticResource PrimaryBrush}" />
                        <TextBlock Text="Facturé" Style="{StaticResource ChevronLabelStyle}" Margin="14,0,0,0" Foreground="{StaticResource TextInverseBrush}" />
                    </Grid>
                    <Grid Margin="-16,0,0,0">
                        <Polygon Style="{StaticResource ChevronStyle}"
                                 Fill="{Binding WorkflowStepIndex, Converter={StaticResource WorkflowStepBrushConverter}, ConverterParameter=4}" />
                        <TextBlock Text="Payé" Style="{StaticResource ChevronLabelStyle}" Margin="14,0,0,0"
                                   Foreground="{Binding WorkflowStepIndex, Converter={StaticResource WorkflowStepTextBrushConverter}, ConverterParameter=4}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Corps -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Informations -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Informations" Style="{StaticResource SubheadingText}" Margin="0,0,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CLIENT" Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="{Binding CustomerName}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding CustomerAddressLine}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="ÉCHÉANCE" Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="{Binding DueDate, StringFormat='{}{0:dd/MM/yyyy}'}" Style="{StaticResource BodyText}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Lignes (lecture seule) -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Lignes de facture" Style="{StaticResource SubheadingText}" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" FontWeight="Medium" />
                                                <TextBlock Style="{StaticResource CaptionText}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} × {1:N2} € {2}">
                                                            <Binding Path="Quantity" />
                                                            <Binding Path="UnitPriceHt" />
                                                            <Binding Path="Unit" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding LineTotalHt, StringFormat='{}{0:N2} €'}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel HorizontalAlignment="Right" Margin="0,10,0,0" MinWidth="240">
                                <Grid Margin="0,3"><TextBlock Text="Total HT" Style="{StaticResource SecondaryText}" /><TextBlock Text="{Binding SubtotalHt, StringFormat='{}{0:N2} €'}" Style="{StaticResource BodyText}" HorizontalAlignment="Right" /></Grid>
                                <Grid Margin="0,3"><TextBlock Text="TVA" Style="{StaticResource SecondaryText}" /><TextBlock Text="{Binding TotalTax, StringFormat='{}{0:N2} €'}" Style="{StaticResource BodyText}" HorizontalAlignment="Right" /></Grid>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,8" />
                                <Grid><TextBlock Text="Total TTC" Style="{StaticResource SubheadingText}" /><TextBlock Text="{Binding TotalTtc, StringFormat='{}{0:N2} €'}" Style="{StaticResource SubheadingText}" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right" /></Grid>
                                <Grid Margin="0,10,0,0"><TextBlock Text="Déjà payé" Style="{StaticResource SecondaryText}" /><TextBlock Text="{Binding AmountPaid, StringFormat='{}{0:N2} €'}" Style="{StaticResource BodyText}" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right" /></Grid>
                                <Grid Margin="0,3"><TextBlock Text="Solde restant" Style="{StaticResource SecondaryText}" /><TextBlock Text="{Binding Balance, StringFormat='{}{0:N2} €'}" Style="{StaticResource BodyText}" FontWeight="Bold" HorizontalAlignment="Right" /></Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Encaissement -->
                    <Border Style="{StaticResource CardStyle}" Visibility="{Binding CanRecordPayment, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Enregistrer un paiement" Style="{StaticResource SubheadingText}" Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="MONTANT" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding NewPaymentAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInputStyle}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="DATE" Style="{StaticResource CaptionText}" />
                                    <DatePicker SelectedDate="{Binding NewPaymentDate}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="MOYEN" Style="{StaticResource CaptionText}" />
                                    <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding NewPaymentMethod}"
                                              Style="{StaticResource ComboBoxInputStyle}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="6" Content="Enregistrer" Style="{StaticResource PrimaryButtonStyle}"
                                        VerticalAlignment="Bottom" Command="{Binding RecordPaymentCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Historique -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Historique des paiements" Style="{StaticResource SubheadingText}" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding Payments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource SecondaryText}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:dd/MM/yyyy} · {1}">
                                                        <Binding Path="PaymentDate" />
                                                        <Binding Path="Method" Converter="{StaticResource PaymentMethodLabelConverter}" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat='{}{0:N2} €'}" Style="{StaticResource BodyText}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Cette facture provient d'un devis accepté." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                    <TextBlock Text="Les lignes ne peuvent plus être modifiées : seul l'enregistrement d'un paiement fait progresser son statut." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
