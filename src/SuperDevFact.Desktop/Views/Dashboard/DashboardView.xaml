<UserControl x:Class="SuperDevFact.Desktop.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:SuperDevFact.Desktop.Converters"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:dashboardVm="clr-namespace:SuperDevFact.Desktop.ViewModels.Dashboard"
             mc:Ignorable="d" d:DesignHeight="1000" d:DesignWidth="1300">

    <UserControl.Resources>
        <conv:StatusLabelConverter x:Key="StatusLabelConverter" />
        <conv:StatusBrushConverter x:Key="StatusBrushConverter" />
        <conv:StatusForegroundConverter x:Key="StatusForegroundConverter" />
        <conv:StatusIconConverter x:Key="StatusIconConverter" />
        <conv:HexToBrushConverter x:Key="HexToBrushConverter" />
        <conv:TrendDirectionBrushConverter x:Key="TrendDirectionBrushConverter" />
        <conv:TrendDirectionIconConverter x:Key="TrendDirectionIconConverter" />

        <!-- Petit sélecteur de période (30 jours / Trimestre / Année), façon "pilule" -->
        <Style x:Key="PeriodToggleStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" CornerRadius="6" Padding="10,5" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <ScrollViewer Padding="28">
            <StackPanel>

                <!-- Bannière d'accueil : la vraie porte d'entrée du logiciel -->
                <Border CornerRadius="16" Padding="28,24" Margin="0,0,0,24" Background="{StaticResource NavyGlassBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" Source="/Assets/Logo.png" Width="110" Stretch="Uniform" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                            <TextBlock Text="Bonjour Jean !" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextInverseBrush}" />
                            <TextBlock Foreground="{StaticResource TextInverseMutedBrush}" Margin="0,4,0,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:N0} € encaissés au total sur Solaris Installation.">
                                        <Binding Path="TotalRevenueCollected" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Center" Command="{Binding NewQuoteCommand}">
                            <StackPanel Orientation="Horizontal">
                                <mi:MaterialIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Nouveau devis" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <TextBlock Text="Tableau de bord" Style="{StaticResource DisplayText}" Margin="0,0,0,4" />
                <TextBlock Text="Un aperçu de l'activité de Solaris Installation." Style="{StaticResource SecondaryText}" Margin="0,0,0,20" />

                <!-- Évolution du CA + Taux de transformation (report de la version web) -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <TextBlock Text="CHIFFRE D'AFFAIRES ENCAISSÉ" Style="{StaticResource CaptionText}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <RadioButton Content="30 jours" GroupName="RevenuePeriod" IsChecked="{Binding IsDays30, Mode=OneWay}"
                                                 Command="{Binding SetPeriodCommand}" CommandParameter="{x:Static dashboardVm:RevenuePeriod.Days30}"
                                                 Style="{StaticResource PeriodToggleStyle}" />
                                    <RadioButton Content="Trimestre" GroupName="RevenuePeriod" IsChecked="{Binding IsQuarter, Mode=OneWay}"
                                                 Command="{Binding SetPeriodCommand}" CommandParameter="{x:Static dashboardVm:RevenuePeriod.Quarter}"
                                                 Style="{StaticResource PeriodToggleStyle}" Margin="4,0,0,0" />
                                    <RadioButton Content="Année" GroupName="RevenuePeriod" IsChecked="{Binding IsYear, Mode=OneWay}"
                                                 Command="{Binding SetPeriodCommand}" CommandParameter="{x:Static dashboardVm:RevenuePeriod.Year}"
                                                 Style="{StaticResource PeriodToggleStyle}" Margin="4,0,0,0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource DisplayText}" Margin="0,0,0,10">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:N0} €">
                                        <Binding Path="TotalRevenueCollected" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <lvc:CartesianChart Series="{Binding RevenueSeries}" XAxes="{Binding RevenueXAxes}"
                                                YAxes="{Binding RevenueYAxes}" Height="190" Background="Transparent" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TAUX DE TRANSFORMATION" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
                            <Grid Margin="0,10,0,0" Width="150" Height="150">
                                <lvc:PieChart Series="{Binding ConversionSeries}" LegendPosition="Hidden" TooltipPosition="Hidden" Background="Transparent" />
                                <TextBlock Text="{Binding ConversionRatePercent, StringFormat='{}{0:N1}%'}" Style="{StaticResource MetricValueText}"
                                           FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                            <TextBlock Text="Devis envoyés transformés en facture" Style="{StaticResource CaptionText}"
                                       Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Cartes-compteurs : icône, valeur, évolution réelle sur 30 jours -->
                <ItemsControl ItemsSource="{Binding MetricCards}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type dashboardVm:MetricCardViewModel}">
                            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,12,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource IconBadgeStyle}"
                                            Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" VerticalAlignment="Top">
                                        <mi:MaterialIcon Kind="{Binding Icon}" Width="19" Height="19" Foreground="White"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Trend.Value}" Style="{StaticResource MetricValueText}" />
                                            <StackPanel Orientation="Horizontal" Margin="8,0,0,3" VerticalAlignment="Bottom">
                                                <mi:MaterialIcon Kind="{Binding Trend.Direction, Converter={StaticResource TrendDirectionIconConverter}}"
                                                                  Width="13" Height="13" Foreground="{Binding Trend.Direction, Converter={StaticResource TrendDirectionBrushConverter}}" />
                                                <TextBlock Text="{Binding Trend.PercentChange, StringFormat='{}{0:N0}%'}" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,0"
                                                           Foreground="{Binding Trend.Direction, Converter={StaticResource TrendDirectionBrushConverter}}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Graphiques -->
                <Grid Margin="0,12,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <mi:MaterialIcon Kind="ChartBarStacked" Width="18" Height="18" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Devis par statut" Style="{StaticResource SubheadingText}" />
                            </StackPanel>
                            <TextBlock Text="Répartition de tous les devis créés." Style="{StaticResource CaptionText}" Margin="0,0,0,14" />
                            <lvc:CartesianChart Series="{Binding QuoteStatusSeries}" XAxes="{Binding QuoteStatusXAxes}"
                                                YAxes="{Binding QuoteStatusYAxes}" Height="260" Background="Transparent" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <mi:MaterialIcon Kind="ChartDonut" Width="18" Height="18" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Factures par statut" Style="{StaticResource SubheadingText}" />
                            </StackPanel>
                            <TextBlock Text="Où en sont les encaissements." Style="{StaticResource CaptionText}" Margin="0,0,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <lvc:PieChart Series="{Binding InvoiceStatusSeries}" Height="220" LegendPosition="Hidden" Background="Transparent" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock Text="{Binding InvoiceTotalCount}" Style="{StaticResource MetricValueText}" HorizontalAlignment="Center" />
                                        <TextBlock Text="factures" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
                                        <TextBlock Text="total" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ItemsControl ItemsSource="{Binding InvoiceStatusShares}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type dashboardVm:InvoiceStatusShareViewModel}">
                                                <StackPanel Margin="0,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionText}" Margin="6,0,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="14,0,0,0">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} · {1:N0}%">
                                                                <Binding Path="Count" />
                                                                <Binding Path="PercentShare" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Derniers devis (colonne large) + Besoin d'aide (colonne étroite) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <mi:MaterialIcon Kind="FileDocumentMultipleOutline" Width="18" Height="18" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Derniers devis" Style="{StaticResource SubheadingText}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="N°" Style="{StaticResource CaptionText}" />
                            <TextBlock Grid.Column="2" Text="Client" Style="{StaticResource CaptionText}" />
                            <TextBlock Grid.Column="3" Text="Date" Style="{StaticResource CaptionText}" />
                            <TextBlock Grid.Column="4" Text="Montant HT" Style="{StaticResource CaptionText}" />
                            <TextBlock Grid.Column="5" Text="Statut" Style="{StaticResource CaptionText}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding RecentQuotes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectQuote, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <mi:MaterialIcon Grid.Column="0" Kind="{Binding DisplayStatus, Converter={StaticResource StatusIconConverter}}"
                                                              Width="16" Height="16" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Number}" Style="{StaticResource BodyText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding CustomerName}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding IssueDate, StringFormat='{}{0:dd/MM/yyyy}'}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding TotalHt, StringFormat='{}{0:N2} €'}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                            <Border Grid.Column="5" Style="{StaticResource StatusBadgeStyle}" HorizontalAlignment="Left"
                                                    Background="{Binding DisplayStatus, Converter={StaticResource StatusBrushConverter}}">
                                                <TextBlock Style="{StaticResource StatusBadgeTextStyle}" Text="{Binding DisplayStatus, Converter={StaticResource StatusLabelConverter}}"
                                                           Foreground="{Binding DisplayStatus, Converter={StaticResource StatusForegroundConverter}}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- TaskPulse : simulation décorative de rappels/notes personnelles (aucune donnée réelle) -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <mi:MaterialIcon Kind="AutoAwesome" Width="16" Height="16" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="TaskPulse" Style="{StaticResource SubheadingText}" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" CornerRadius="999" Padding="8,2" Background="{StaticResource NeutralSoftBrush}">
                                <TextBlock Text="APERÇU" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding TaskPulseItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type dashboardVm:TaskPulseItemViewModel}">
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="10,9" Margin="0,0,0,8" Cursor="Arrow">
                                        <Border.RenderTransform>
                                            <TranslateTransform X="0" />
                                        </Border.RenderTransform>
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="Border.MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X" To="4" Duration="0:0:0.18" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="Border.MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X" To="0" Duration="0:0:0.18" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                        <StackPanel Orientation="Horizontal">
                                            <mi:MaterialIcon Kind="{Binding Icon}" Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,8,0"
                                                              Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" />
                                            <TextBlock Text="{Binding Text}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
